# LINE Messaging API credentials
LINE_CHANNEL_ID=your_channel_id_here
LINE_CHANNEL_SECRET=your_channel_secret_here
# Optional: Leave empty to automatically issue & refresh Stateless Channel Access Tokens (v3)
# using LINE_CHANNEL_ID and LINE_CHANNEL_SECRET.
LINE_CHANNEL_ACCESS_TOKEN=

# Server settings
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Qwen AI model settings
# Backend: "local" (runs Qwen in-process via Hugging Face transformers) or "ollama"
QWEN_BACKEND=local
QWEN_MODEL_NAME=Qwen/Qwen2.5-0.5B-Instruct
QWEN_SYSTEM_PROMPT=You are a helpful, concise AI assistant on LINE. Reply in the same language as the user.
QWEN_MAX_NEW_TOKENS=512
QWEN_TEMPERATURE=0.7
QWEN_TOP_P=0.9
QWEN_LAZY_LOAD=false
MAX_HISTORY_TURNS=6

# Only used if QWEN_BACKEND=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL_NAME=qwen2.5:1.5b
